# Every VITE_-prefixed variable ships inside the client bundle — never put a
# service-role or secret key here.

# Supabase project URL (Project Settings -> API)
VITE_SUPABASE_URL=

# Supabase anon/public key (safe for the client — RLS enforces access)
VITE_SUPABASE_ANON_KEY=

# PostHog public project API key (client-safe)
VITE_POSTHOG_KEY=

# PostHog ingestion host, e.g. https://us.i.posthog.com
VITE_POSTHOG_HOST=

# Environment label surfaced in client telemetry, e.g. development | staging | production
VITE_APP_ENV=
