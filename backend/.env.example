# Backend environment variables, per prompt_course_platform.md's frozen
# "Environment variable names" list. Read by `_shared/config.ts`'s
# `loadBackendConfig()`, called once at module scope (cold start) by every
# Edge Function — a missing/invalid var here fails the function's boot with
# a single error listing everything wrong, not a confusing runtime error on
# the first real request.
#
# FOR LOCAL DEV: copy this file to `backend/supabase/functions/.env` (NOT
# `backend/.env`) — that is the exact path Supabase's local Edge Runtime
# reads secrets from (confirmed empirically: `supabase start` only picks
# these up from that path). Fake-but-well-formed values are enough to make
# every function boot and exercise its own validation/error-handling logic
# locally; you only need real credentials to actually create a PIX charge,
# send a real email, or see events land in PostHog.
#
# FOR DEPLOYMENT: set these via `supabase secrets set --env-file
# backend/.env` (with real values, never committed) — SUPABASE_URL,
# SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY below are the one
# exception: never set them yourself, they are auto-injected into every
# deployed Edge Function by the platform.

# --- Auto-injected by Supabase, DO NOT SET ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Mercado Pago) ---
# Only "mercadopago" is implemented; optional, defaults to "mercadopago".
PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Public URL Mercado Pago will POST webhook notifications to, e.g.
# https://<project-ref>.supabase.co/functions/v1/payments-webhook
MERCADOPAGO_NOTIFICATION_URL=
# Optional, defaults to 1800 (30 minutes).
PIX_CHARGE_TTL_SECONDS=1800

# --- Video ---
# "youtube" or "panda"; optional, defaults to "youtube".
VIDEO_PROVIDER=youtube
# Only required when VIDEO_PROVIDER=panda.
PANDA_API_KEY=
PANDA_SIGNED_URL_TTL_SECONDS=

# --- Transactional email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# --- Observability (PostHog, server-side) ---
POSTHOG_API_KEY=
# e.g. https://us.i.posthog.com
POSTHOG_HOST=

# --- Cron authentication ---
# Shared secret checked via the X-Cron-Secret header on payments-reconcile
# and outbox-drain — generate a long random value, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# --- Branding / misc ---
# Public app URL, used in email CTAs and as the payments-reconcile /
# outbox-drain caller's own reference point.
APP_PUBLIC_URL=
COMPANY_NAME=
SUPPORT_EMAIL=
