{
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@supabase/supabase-js": "jsr:@supabase/supabase-js@2"
  },
  "tasks": {
    "test": "deno test --allow-read=.,../frontend/src/contracts --allow-env --coverage=coverage",
    "coverage": "deno coverage coverage --lcov --output=coverage/lcov.info",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "fmt": {
    "include": ["contracts/", "supabase/functions/"],
    "exclude": ["contracts/video.ts"],
    "lineWidth": 100,
    "singleQuote": true
  },
  "lint": {
    "include": ["contracts/", "supabase/functions/"]
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "exclude": ["supabase/.branches", "supabase/.temp", "coverage"]
}
